        "type": "number",
        "min": 0.01,
        "max": 3600,
        "step": 0.01,
        "score": false,
        "required": false,
        "optionalGroup": "Tempos medidos"
      },
      {
        "id": "tempo_marcha_2",
        "label": "Marcha — tentativa 2 (s)",
        "type": "number",
        "min": 0.01,
        "max": 3600,
        "step": 0.01,
        "score": false,
        "required": false,
        "optionalGroup": "Tempos medidos"
      },
      {
        "id": "tempo_cadeira",
        "label": "Cinco levantamentos — tempo (s)",
        "type": "number",
        "min": 0.01,
        "max": 3600,
        "step": 0.01,
        "score": false,
        "required": false,
        "optionalGroup": "Tempos medidos"
      }
